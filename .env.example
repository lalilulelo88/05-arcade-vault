# Copia este archivo a .env.local y rellena los valores. Solo servidor: nunca uses el prefijo NEXT_PUBLIC_.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Destinatario del formulario de contacto.
# Con el sandbox de Resend (onboarding@resend.dev) solo se puede enviar al correo de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Opcional. Remitente; por defecto "Arcade Vault <onboarding@resend.dev>".
# Cambiar solo cuando tengas un dominio verificado en Resend.
# RESEND_FROM=Arcade Vault <contacto@tudominio.com>

# Supabase (https://supabase.com/dashboard/project/_/settings/api-keys)
# URL del proyecto. Pública por diseño; la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publishable (sb_publishable_...). Nunca uses aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
